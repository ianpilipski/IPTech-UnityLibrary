#age-signals-access-result-popup {
    position: relative;
    width: 100%;
    height: 100%;
}

#age-signals-access-result-ui {
    position: relative;
    width: 100%;
    height: 100%;
}

.ageui-invalid-field {
    background-color: rgba(255, 0, 0, 0.3);
}

.ageui-popup-root {
    position: relative;
    width: 100%;
    height: 100%;
}

.ageui-section {
    margin-bottom: 15px;
}

.ageui-group {
    flex-direction: column;
    width: 100%;
    height: auto;
    position: relative;
}

.ageui-property-field {
    padding-left: 15px;
}

.ageui-section > Label {
    -unity-font-style: bold;
}

.ageui-dialog-box {
    flex-direction: column;
    flex-shrink: 1;
    flex-grow: 0;
    background-color: rgba(1, 1, 1, 0.15);
    max-width: 90%;
    max-height: 90%;
    min-width: 90%;
    padding: 15px;
    margin: 15px;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--unity-colors-box-border);
    background-color: var(--unity-colors-box-background);
}

.ageui-full-screen-overlay {
    position: absolute;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    display: flex;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
}
