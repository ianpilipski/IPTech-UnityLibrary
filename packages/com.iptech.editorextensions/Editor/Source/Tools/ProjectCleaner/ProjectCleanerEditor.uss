:root {
    overflow: hidden;
}

.page {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    transition-property: translate;
    transition-duration: 220ms;
    transition-timing-function: ease-in-out;
}

#project-cleaner-preview {
    translate: 100% 0;
    display: none;
    padding-bottom: 6px;
}

.no-shrink {
    flex-shrink: 0;
}

.tab-content-host {
    flex-grow: 1;
    min-height: 0;
}

.tab-content {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.settings-header {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.settings-content {
    flex-grow: 1;
    min-height: 0;
}

#search {
    flex-grow: 1;
    min-width: 100px;
    flex-shrink: 1;
}

.filter {
    min-width: 0;
    flex-shrink: 0;
}

.filter > .unity-base-field__label {
    min-width: 0;
    width: auto;
    flex-shrink: 0;
    margin-right: 4px;
}

#status { width: 160px; }
#scope { width: 200px; }
#sort { width: 170px; }

.protected-folders-list {
    max-height: 220px;
    min-height: 50px;
}

.protected-folders-box {
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(128, 128, 128, 0.6);
    padding: 8px;
    margin-top: 6px;
    margin-bottom: 8px;
}

.protected-folders-title {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.protected-folders-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 6px;
}

#add-protected-folder {
    width: 100px;
    flex-shrink: 0;
}

.protected-folder-row {
    flex-direction: row;
    align-items: center;
}

.protected-folder-path {
    flex-grow: 1;
}

#split {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
}

#results {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

#details {
    padding-left: 8px;
    min-width: 180px;
    min-height: 0;
}

.cleanup {
    margin-top: 4px;
}

.wrapped-label {
    white-space: normal;
    margin-bottom: 8px;
}

.cell {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.preview-title {
    font-size: 18px;
    margin-bottom: 8px;
}

#project-cleaner-preview-assets {
    flex-grow: 1;
    min-height: 0;
}

.preview-buttons {
    flex-direction: row;
}
